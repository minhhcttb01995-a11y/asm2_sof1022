@* [VIEW-HEADER-ADDED]
   View cho action "Statuses" trong khu vực trang quản trị Admin (AdminController).
   [UPDATED] Thêm/Sửa trạng thái giờ dùng modal ngay tại trang này (không chuyển sang
   trang khác), modal Sửa sẽ tự điền đúng dữ liệu hiện tại của dòng vừa bấm nên không
   còn bị mất thông tin cũ khi mở form sửa.
*@
@using JobConnect.Models
@{
    ViewData["Title"] = "Quản lý Trạng thái";
    Layout = "_LayoutAdmin";
    var entityTypes = (string[])ViewBag.EntityTypes;
    var entityTypeLabels = (Dictionary<string, string>)ViewBag.EntityTypeLabels;
}

<div class="max-w-[1700px] mx-auto px-6 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-on-surface">Quản lý Trạng thái</h1>
            <p class="text-secondary text-sm">Tùy chỉnh danh mục trạng thái cho Ứng viên, Nhà tuyển dụng, Nhân viên, Công ty, Tin tuyển dụng</p>
        </div>
        <button type="button" onclick="openStatusCreateModal()" class="px-5 py-2.5 bg-primary text-slate-900 rounded-xl text-sm font-semibold hover:opacity-90 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">add</span>
            Thêm trạng thái mới
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 rounded-xl text-sm auto-hide-alert">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm">
            @TempData["Error"]
        </div>
    }

    <!-- Filter -->
    <div class="bg-white rounded-2xl border border-outline-variant p-4 mb-6">
        <form method="get" asp-action="Statuses" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-secondary mb-1">Đối tượng áp dụng</label>
                <select name="entityType" class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm">
                    <option value="">Tất cả</option>
                    @foreach (var et in entityTypes)
                    {
                        <option value="@et" selected="@(ViewBag.EntityTypeFilter == et)">@entityTypeLabels[et]</option>
                    }
                </select>
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-secondary mb-1">Từ khóa</label>
                <input type="text" name="keyword" value="@ViewBag.KeywordFilter" placeholder="Tên hoặc mã trạng thái..."
                       class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm" />
            </div>
            <button type="submit" class="px-5 py-2.5 bg-primary text-slate-900 rounded-xl text-sm font-semibold hover:opacity-90">
                Lọc
            </button>
            <a asp-action="Statuses" class="px-5 py-2.5 border border-outline-variant rounded-xl text-sm font-medium text-secondary hover:bg-surface-container">
                Đặt lại
            </a>
        </form>
    </div>

    <!-- Table -->
    @{
        var statuses = (List<StatusCatalog>)ViewBag.Statuses;
    }
    @if (statuses != null && statuses.Any())
    {
        <div class="bg-white rounded-2xl border border-outline-variant overflow-hidden">
            <table class="w-full">
                <thead class="bg-surface-container">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-on-surface">Đối tượng</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-on-surface">Tên hiển thị</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-on-surface">Xem trước</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-on-surface">Mô tả</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-on-surface">Hiển thị</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-on-surface">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in statuses)
                    {
                        <tr class="border-t border-outline-variant hover:bg-surface-container-low">
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-medium">
                                    @(entityTypeLabels.ContainsKey(s.EntityType) ? entityTypeLabels[s.EntityType] : s.EntityType)
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-medium text-on-surface">@s.Name</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-3 py-1 rounded-full text-xs font-medium @(string.IsNullOrWhiteSpace(s.ColorClass) ? "bg-gray-100 text-gray-700" : s.ColorClass)">
                                    @s.Name
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-secondary">@s.Description</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (s.IsActive)
                                {
                                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-medium">Đã ẩn</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button"
                                            class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg js-edit-status-btn" title="Sửa"
                                            data-id="@s.Id"
                                            data-entitytype="@s.EntityType"
                                            data-code="@s.Code"
                                            data-name="@s.Name"
                                            data-colorclass="@s.ColorClass"
                                            data-description="@s.Description"
                                            data-isactive="@(s.IsActive ? "true" : "false")">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </button>
                                    <form asp-action="StatusToggle" asp-route-id="@s.Id" method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn thay đổi hiển thị trạng thái này?')"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 @(s.IsActive ? "text-orange-600 hover:bg-orange-50" : "text-green-600 hover:bg-green-50") rounded-lg"
                                                title="@(s.IsActive ? "Ẩn" : "Hiện")">
                                            <span class="material-symbols-outlined text-sm">@(s.IsActive ? "visibility_off" : "visibility")</span>
                                        </button>
                                    </form>
                                    <form asp-action="StatusDelete" asp-route-id="@s.Id" method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa trạng thái này?')"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg" title="Xóa">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl p-12 text-center border border-outline-variant">
            <span class="material-symbols-outlined text-6xl text-secondary mb-4">tune</span>
            <p class="text-lg text-secondary">Không tìm thấy trạng thái nào</p>
            <button type="button" onclick="openStatusCreateModal()" class="inline-block mt-4 px-5 py-2.5 bg-primary text-slate-900 rounded-xl text-sm font-semibold hover:opacity-90">
                Thêm trạng thái đầu tiên
            </button>
        </div>
    }
</div>

<!-- ============== MODAL: Thêm / Sửa trạng thái ============== -->
<div id="status-modal-overlay" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between">
            <h2 id="status-modal-title" class="text-lg font-bold text-on-surface">Thêm trạng thái mới</h2>
            <button type="button" onclick="closeStatusModal()" class="p-1.5 text-secondary hover:bg-surface-container rounded-lg">
                <span class="material-symbols-outlined text-xl">close</span>
            </button>
        </div>

        <form id="status-modal-form" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="status-Id" name="Id" value="0" />
            <div class="px-6 py-5">
                <div id="status-modal-error" class="hidden mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm"></div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-on-surface mb-1">Đối tượng áp dụng <span class="text-red-500">*</span></label>
                    <select id="status-EntityType" name="EntityType" required class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm">
                        @foreach (var et in entityTypes)
                        {
                            <option value="@et">@entityTypeLabels[et]</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-on-surface mb-1">Mã trạng thái (Code) <span class="text-red-500">*</span></label>
                    <input id="status-Code" name="Code" placeholder="Ví dụ: Active, Open, Banned..." class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm" />
                    <p class="text-xs text-secondary mt-1">
                        Lưu ý: với "Nhân viên" (Staff), Code phải là số nguyên (0 = Đang làm việc, 1 = Đã khóa...) vì cột trạng thái của Nhân viên đang là kiểu số.
                    </p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-on-surface mb-1">Tên hiển thị <span class="text-red-500">*</span></label>
                    <input id="status-Name" name="Name" required placeholder="Ví dụ: Hoạt động" class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-on-surface mb-1">Class màu badge (Tailwind)</label>
                    <input id="status-ColorClass" name="ColorClass" placeholder="Ví dụ: bg-green-100 text-green-700" class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm" />
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-on-surface mb-1">Mô tả</label>
                    <textarea id="status-Description" name="Description" rows="3" placeholder="Mô tả chi tiết về trạng thái này..." class="w-full px-4 py-2.5 border border-outline-variant rounded-xl text-sm"></textarea>
                </div>

                <div class="flex items-center gap-2">
                    <input id="status-IsActive" name="IsActive" type="checkbox" value="true" checked class="w-4 h-4" />
                    <input type="hidden" name="IsActive" value="false" />
                    <label for="status-IsActive" class="text-sm text-on-surface">Hiển thị trạng thái này</label>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-outline-variant flex items-center justify-end gap-3">
                <button type="button" onclick="closeStatusModal()" class="px-5 py-2.5 border border-outline-variant rounded-xl text-sm font-medium text-secondary hover:bg-surface-container">
                    Hủy
                </button>
                <button type="submit" class="px-5 py-2.5 bg-primary text-slate-900 rounded-xl text-sm font-semibold hover:opacity-90">
                    Lưu trạng thái
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const STATUS_CREATE_URL = '@Url.Action("StatusCreate", "Admin")';
        const STATUS_EDIT_URL = '@Url.Action("StatusEdit", "Admin")';

        const statusModalOverlay = document.getElementById('status-modal-overlay');
        const statusModalTitle = document.getElementById('status-modal-title');
        const statusModalForm = document.getElementById('status-modal-form');

        function resetStatusForm() {
            document.getElementById('status-Id').value = '0';
            document.getElementById('status-EntityType').selectedIndex = 0;
            document.getElementById('status-Code').value = '';
            document.getElementById('status-Name').value = '';
            document.getElementById('status-ColorClass').value = '';
            document.getElementById('status-Description').value = '';
            document.getElementById('status-IsActive').checked = true;
            const errBox = document.getElementById('status-modal-error');
            if (errBox) { errBox.classList.add('hidden'); errBox.textContent = ''; }
        }

        function openStatusCreateModal() {
            resetStatusForm();
            statusModalTitle.textContent = 'Thêm trạng thái mới';
            statusModalForm.action = STATUS_CREATE_URL;
            statusModalOverlay.classList.remove('hidden');
        }

        function openStatusEditModal(data) {
            resetStatusForm();
            statusModalTitle.textContent = 'Sửa trạng thái: ' + data.name;
            statusModalForm.action = STATUS_EDIT_URL;
            document.getElementById('status-Id').value = data.id;
            document.getElementById('status-EntityType').value = data.entitytype;
            document.getElementById('status-Code').value = data.code || '';
            document.getElementById('status-Name').value = data.name || '';
            document.getElementById('status-ColorClass').value = data.colorclass || '';
            document.getElementById('status-Description').value = data.description || '';
            document.getElementById('status-IsActive').checked = (data.isactive === 'true');
            statusModalOverlay.classList.remove('hidden');
        }

        function closeStatusModal() {
            statusModalOverlay.classList.add('hidden');
        }

        // Gắn sự kiện cho từng nút "Sửa" trong bảng — mỗi nút mang sẵn dữ liệu
        // của đúng dòng đó (qua data-*) nên khi mở modal luôn hiển thị đúng
        // thông tin hiện tại, không bị mất hay lẫn sang dòng khác.
        document.querySelectorAll('.js-edit-status-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                openStatusEditModal(btn.dataset);
            });
        });

        statusModalOverlay.addEventListener('click', function(e) {
            if (e.target === statusModalOverlay) closeStatusModal();
        });

        // Gửi form Thêm/Sửa trạng thái bằng AJAX: nếu có lỗi (VD: Code trùng),
        // hiển thị thông báo ngay trong modal thay vì điều hướng sang trang khác.
        statusModalForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const errBox = document.getElementById('status-modal-error');
            const submitBtn = statusModalForm.querySelector('button[type="submit"]');
            errBox.classList.add('hidden');
            errBox.textContent = '';
            submitBtn.disabled = true;

            fetch(statusModalForm.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(statusModalForm)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        errBox.textContent = data.message || 'Có lỗi xảy ra, vui lòng thử lại.';
                        errBox.classList.remove('hidden');
                        submitBtn.disabled = false;
                    }
                })
                .catch(() => {
                    errBox.textContent = 'Có lỗi xảy ra, vui lòng thử lại.';
                    errBox.classList.remove('hidden');
                    submitBtn.disabled = false;
                });
        });
    </script>
}
