@* [VIEW-HEADER-ADDED]
   View cho action "ManageJobs" — trang riêng để quản lý danh sách tin tuyển dụng
   (sửa/xóa/xem đơn ứng tuyển), tách khỏi Dashboard (chỉ còn số liệu thống kê).
*@
@using JobConnect.Models
@model List<JobPost>
@{
    ViewData["Title"] = "Quản lý tin đăng";
    Layout = "_LayoutEmployer";

    var employer = ViewBag.Employer as Employer;
}

<div class="space-y-6">

    <!-- Page header -->
    <div class="jc-page-header">
        <div>
            <h1 class="jc-page-title">Quản lý tin đăng</h1>
            <p class="jc-page-subtitle">
                <span class="material-symbols-outlined" style="font-size:14px">apartment</span>
                @(employer?.CompanyName ?? "Công ty của bạn")
            </p>
        </div>
        <a asp-action="PostJob" class="jc-btn jc-btn-primary">
            <span class="material-symbols-outlined" style="font-size:18px">add_circle</span>
            Đăng tin mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="margin-bottom:16px;padding:12px 16px;background:rgba(34,197,94,.1);color:#4ade80;border:1px solid rgba(34,197,94,.3);border-radius:12px;font-size:14px;font-weight:500;display:flex;align-items:center;gap:8px">
            <span class="material-symbols-outlined" style="font-size:18px">check_circle</span>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom:16px;padding:12px 16px;background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.3);border-radius:12px;font-size:14px;font-weight:500;display:flex;align-items:center;gap:8px">
            <span class="material-symbols-outlined" style="font-size:18px">error</span>
            @TempData["Error"]
        </div>
    }

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <h2 style="font-size:1rem;font-weight:600;color:#e2e8f0;margin:0;display:flex;align-items:center;gap:8px">
            <span class="material-symbols-outlined" style="font-size:18px;color:#64748b">list_alt</span>
            Danh sách tin tuyển dụng
        </h2>
    </div>

    <div class="jc-table-wrap">
        <table class="jc-table">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Trạng thái</th>
                    <th>Lượt xem</th>
                    <th>Đơn ứng tuyển</th>
                    <th>Tỷ lệ chuyển đổi</th>
                    <th>Hết hạn</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var job in Model)
                    {
                        var badgeClass = job.Status switch
                        {
                            "Active" => "jc-badge-success",
                            "Pending" => "jc-badge-warning",
                            "Rejected" => "jc-badge-danger",
                            "Banned" => "jc-badge-danger",
                            _ => "jc-badge-neutral"
                        };
                        var statusLabel = job.Status switch
                        {
                            "Active" => "Đang mở",
                            "Pending" => "Chờ duyệt",
                            "Rejected" => "Bị từ chối",
                            "Banned" => "Đã khóa",
                            "Draft" => "Bản nháp",
                            _ => job.Status
                        };
                        bool isExpired = job.Deadline.HasValue && job.Deadline.Value < DateTime.Now;

                        <tr>
                            <td>
                                <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.JobId"
                                   class="jc-table-link">@job.Title</a>
                                @if (isExpired && job.Status == "Active")
                                {
                                    <span style="margin-left:6px;font-size:11px;color:#f87171">(Hết hạn)</span>
                                }
                            </td>
                            <td>
                                <span class="jc-badge @badgeClass">@statusLabel</span>
                            </td>
                            <td style="color:#94a3b8">
                                @job.ViewCount
                            </td>
                            <td style="color:#fff;font-weight:600">
                                @job.Applications.Count
                            </td>
                            <td style="color:#a78bfa;font-weight:600">
                                @(job.ViewCount > 0 ? Math.Round((double)job.Applications.Count / job.ViewCount * 100, 1) : 0)%
                            </td>
                            <td style="color:@(isExpired ? "#f87171" : "#94a3b8")">
                                @(job.Deadline?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td>
                                <div style="display:flex;gap:8px">
                                    <a asp-action="ManageApplications" asp-route-jobId="@job.JobId"
                                       style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:rgba(59,130,246,.15);color:#60a5fa;border-radius:8px;font-size:12px;font-weight:500;text-decoration:none;transition:background .15s"
                                       onmouseover="this.style.background='rgba(59,130,246,.25)'"
                                       onmouseout="this.style.background='rgba(59,130,246,.15)'">
                                        <span class="material-symbols-outlined" style="font-size:14px">people</span>
                                        Quản lý đơn
                                    </a>
                                    @{
                                        // RULE: "đã từng hiển thị công khai" (Active, hoặc đã hết hạn dù ở status
                                        // nào) → khóa Sửa hoàn toàn. "Chưa từng hiển thị công khai" (Pending, Rejected)
                                        // và chưa hết hạn → sửa tự do. Xem CanEditJob() trong EmployerController.
                                        bool canEdit = !isExpired && (job.Status == "Pending" || job.Status == "Rejected");
                                    }
                                    @if (canEdit)
                                    {
                                        <a asp-action="EditJob" asp-route-id="@job.JobId"
                                           style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:rgba(255,255,255,.06);color:#94a3b8;border-radius:8px;font-size:12px;font-weight:500;text-decoration:none;transition:background .15s"
                                           onmouseover="this.style.background='rgba(255,255,255,.12)';this.style.color='#fff'"
                                           onmouseout="this.style.background='rgba(255,255,255,.06)';this.style.color='#94a3b8'">
                                            <span class="material-symbols-outlined" style="font-size:14px">edit</span>
                                            Sửa
                                        </a>
                                    }
                                    else
                                    {
                                        <span title="Tin đã đăng/hết hạn không thể sửa. Xóa tin và đăng tin mới nếu muốn thay đổi."
                                              style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:rgba(255,255,255,.03);color:#475569;border-radius:8px;font-size:12px;font-weight:500;cursor:not-allowed">
                                            <span class="material-symbols-outlined" style="font-size:14px">lock</span>
                                            Sửa
                                        </span>
                                    }
                                    @{
                                        var safeTitle = job.Title.Replace("'", "").Replace("\"", "").Replace("\\", "");
                                    }
                                    <form id="deleteForm-@job.JobId" asp-action="DeleteJob" asp-route-id="@job.JobId" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <button type="button"
                                            onclick="jcOpenDeleteModal('@job.JobId', '@safeTitle')"
                                            style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:rgba(239,68,68,.12);color:#f87171;border:none;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;transition:background .15s"
                                            onmouseover="this.style.background='rgba(239,68,68,.22)'"
                                            onmouseout="this.style.background='rgba(239,68,68,.12)'">
                                        <span class="material-symbols-outlined" style="font-size:14px">delete</span>
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:60px 16px">
                            <span class="material-symbols-outlined" style="font-size:40px;color:#334155;display:block;margin-bottom:12px">work_off</span>
                            <p style="color:#64748b;font-size:14px;margin:0 0 16px">Bạn chưa đăng tin tuyển dụng nào</p>
                            <a asp-action="PostJob" class="jc-btn jc-btn-primary">
                                <span class="material-symbols-outlined" style="font-size:18px">add</span>
                                Đăng tin đầu tiên
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== Modal xác nhận xóa tin (thay cho confirm() mặc định của trình duyệt) ===== -->
<div id="jcDeleteOverlay" class="jc-modal-overlay" onclick="if(event.target===this) jcCloseDeleteModal()">
    <div class="jc-modal-box" role="alertdialog" aria-modal="true" aria-labelledby="jcDeleteTitle">
        <div class="jc-modal-icon">
            <span class="material-symbols-outlined" style="font-size:26px">delete_forever</span>
        </div>
        <h3 id="jcDeleteTitle" class="jc-modal-title">Xóa tin tuyển dụng?</h3>
        <p class="jc-modal-text">
            Bạn có chắc muốn xóa tin <strong id="jcDeleteJobName" style="color:#fca5a5"></strong>?
            Tin sẽ bị ẩn khỏi hệ thống ngay lập tức và <strong>không thể hoàn tác</strong>.
        </p>
        <div class="jc-modal-actions">
            <button type="button" class="jc-modal-btn jc-modal-btn-cancel" onclick="jcCloseDeleteModal()">Hủy</button>
            <button type="button" class="jc-modal-btn jc-modal-btn-danger" onclick="jcConfirmDelete()">
                <span class="material-symbols-outlined" style="font-size:16px">delete</span>
                Xóa tin
            </button>
        </div>
    </div>
</div>

<style>
    .jc-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(2,6,23,.72);
        backdrop-filter: blur(3px);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: jcFadeIn .15s ease;
    }

        .jc-modal-overlay.open {
            display: flex;
        }

    .jc-modal-box {
        width: 100%;
        max-width: 420px;
        background: linear-gradient(160deg, #1e293b 0%, #171f31 100%);
        border: 1px solid #334155;
        border-radius: 18px;
        padding: 26px 26px 22px;
        box-shadow: 0 24px 60px -20px rgba(0,0,0,.6);
        animation: jcPopIn .18s ease;
    }

    .jc-modal-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: rgba(239,68,68,.15);
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .jc-modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 8px;
    }

    .jc-modal-text {
        font-size: .87rem;
        line-height: 1.6;
        color: #94a3b8;
        margin: 0 0 22px;
    }

    .jc-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .jc-modal-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 10px;
        font-size: .85rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all .15s;
    }

    .jc-modal-btn-cancel {
        background: rgba(255,255,255,.06);
        border: 1px solid #334155;
        color: #94a3b8;
    }

        .jc-modal-btn-cancel:hover {
            background: rgba(255,255,255,.12);
            color: #fff;
        }

    .jc-modal-btn-danger {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        box-shadow: 0 6px 16px -4px rgba(239,68,68,.5);
    }

        .jc-modal-btn-danger:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px -4px rgba(239,68,68,.6);
        }

    @@keyframes jcFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes jcPopIn {
        from {
            opacity: 0;
            transform: translateY(8px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<script>
    var jcDeleteTargetId = null;

    function jcOpenDeleteModal(jobId, jobTitle) {
        jcDeleteTargetId = jobId;
        document.getElementById('jcDeleteJobName').textContent = '"' + jobTitle + '"';
        document.getElementById('jcDeleteOverlay').classList.add('open');
    }

    function jcCloseDeleteModal() {
        jcDeleteTargetId = null;
        document.getElementById('jcDeleteOverlay').classList.remove('open');
    }

    function jcConfirmDelete() {
        if (!jcDeleteTargetId) return;
        var form = document.getElementById('deleteForm-' + jcDeleteTargetId);
        if (form) form.submit();
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') jcCloseDeleteModal();
    });
</script>
